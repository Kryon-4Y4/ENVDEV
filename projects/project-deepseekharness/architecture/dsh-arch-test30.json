  "cards": [
    {
      "dot": "cyan",
      "title": "① 启动与组装",
      "items": [
        "CLI 启动器 (lib/bin.js) 按 Profile 有序叠加 bundle patch",
        "bundle: dsh-base (宿主核心) / dsh-web-app (浏览器面) / dsh-headless (无界面单次会话)",
        "agent-presets: standard / code / cordis / minimal 四种预设"
      ]
    },
    {
      "dot": "emerald",
      "title": "② 宿主核心注册表",
      "items": [
        "LLM (dsh-llm) + llm-retry + agent-default-model",
        "会话 (dsh-session) + 持久化/查询/标题/投影/遥测/检查点",
        "工具注册表 (dsh-tools) · 系统提示词 (dsh-system-prompt)",
        "子代理注册表 (dsh-subagent) + spawn/fork provider",
        "Skills (dsh-skill) 按 scope 分层合并 · 目标 (dsh-goal) + goal-round-driver",
        "后台任务 (dsh-jobs-local) · Web 搜索 (dsh-web) + web-search-deepseek",
        "命令 (dsh-commands) /compact /export /plan ...",
        "Agent 运行时 (dsh-agent + agent-loop)",
        "API 网关 (api-gateway → host-apiproxy) · Web 服务器 (dsh-host-webserver)",
        "token-meter / compaction-basic / spill / tool-result-pruner"
      ]
    },
    {
      "dot": "rose",
      "title": "② 持久化 + 安全",
      "items": [
        "持久化: JSONL 日志 · SQLite 查询 · 附件字节 · storage-json/domain",
        "安全: 沙箱 (dsh-sandbox-local + sandbox-policy/fs-sandbox) · 用户授权 (dsh-user-approval + permission-presets)",
        "Shell 执行器 (bash-sandbox/pwsh-sandbox) · 文件系统 (dsh-fs-local + fs-observation-policy)",
        "凭据 (dsh-credentials-local + settings-file)"
      ]
    }
  ]
}